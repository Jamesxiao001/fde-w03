  "model_sql": {
    "paid_member_month_summary": "WITH valid_orders AS ( SELECT member_id, CAST(date_trunc('month', ordered_at) AS DATE) AS month_start, order_id, paid_cents - refund_cents AS net_amount_cents FROM {{ ref('orders') }} WHERE status = 'paid' AND paid_cents - refund_cents > 0 ), member_month AS ( SELECT member_id, month_start, COUNT(DISTINCT order_id) AS valid_order_count, SUM(net_amount_cents) AS net_sales_cents FROM valid_orders GROUP BY member_id, month_start ), eligible_member_month AS ( SELECT mm.member_id, mm.month_start, mm.valid_order_count, mm.net_sales_cents FROM member_month mm WHERE EXISTS ( SELECT 1 FROM {{ ref('cards') }} c WHERE c.member_id = mm.member_id AND c.card_type IN ('悦享年卡', '家庭季卡') AND c.valid_from <= CAST(mm.month_start + INTERVAL '1 month' - INTERVAL '1 day' AS DATE) AND c.valid_until > CAST(mm.month_start + INTERVAL '1 month' - INTERVAL '1 day' AS DATE) AND (c.ended_at IS NULL OR c.ended_at > CAST(mm.month_start + INTERVAL '1 month' - INTERVAL '1 day' AS DATE)) ) ) SELECT member_id || '|' || CAST(month_start AS VARCHAR) AS paid_member_month_id, member_id, month_start, valid_order_count, net_sales_cents, CASE WHEN valid_order_count >= 2 THEN member_id END AS repeat_member_id FROM eligible_member_month"
  },
