    {
      "name": "monthly_paid_buyer_count",
      "label": "月末付费会员购买人数",
      "description": "自然月内有至少一笔有效订单、且月末符合总部运营月报付费资格的不同 CRM 会员账户数；按账户去重，不按卡重复。",
      "type": "simple",
      "type_params": {
        "measure": "paid_month_buyer_count_measure"
      }
    },
    {
      "name": "monthly_paid_order_count",
      "label": "月末付费会员有效订单数",
      "description": "月末符合付费资格的账户在该自然月的全部有效订单数，按账户资格筛选，不按卡重复。",
      "type": "simple",
      "type_params": {
        "measure": "paid_month_order_count_measure"
      }
    },
    {
      "name": "monthly_paid_sales_cents",
