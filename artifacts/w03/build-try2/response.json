    {
      "name": "monthly_paid_repeat_buyer_count",
      "label": "月末付费会员复购人数",
      "description": "月末符合付费资格，且同一自然月至少有两笔有效订单的不同账户数。",
      "type": "simple",
      "type_params": {
        "measure": "paid_month_repeat_buyer_count_measure"
      }
    },
    {
      "name": "monthly_paid_repeat_rate",
      "label": "月末付费会员复购率",
      "description": "月末付费会员复购人数除以月末付费会员购买人数；分母为零时未定义。",
      "type": "ratio",
      "type_params": {
        "numerator": "monthly_paid_repeat_buyer_count",
        "denominator": "monthly_paid_buyer_count"
      }
    },
    {
      "name": "monthly_paid_avg_order_value",
      "label": "月末付费会员订单均额",
      "description": "月末付费会员净销售额除以月末付费会员有效订单数；单位分／单，分母零时未定义。",
      "type": "ratio",
      "type_params": {
        "numerator": "monthly_paid_sales_cents",
        "denominator": "monthly_paid_order_count"
      }
    }
  ],
